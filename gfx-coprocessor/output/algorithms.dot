digraph G {
  rankdir=TB;
  node [shape=box, fontname="Helvetica", fontsize=14, style="filled", fillcolor="white", color="black"];
  edge [fontname="Helvetica", fontsize=12, color="black"];

  subgraph cluster_fill {
    label="FILL: Rectangle Fill"; fontsize=18; fontname="Helvetica-Bold";
    start [label="START FILL\l", shape=oval, fillcolor="#F2F2F2"];
    init [label="T2 = H\lT5 = DY\l", shape=box, fillcolor="white"];
    clip [label="T3 = MAX(DX, CX0)\lT4 = MIN(DX+W, CX1)\l", shape=box, fillcolor="white"];
    check1 [label="T4 = T4 - T3\lT4 < 0 ?\l", shape=diamond, fillcolor="#E0E0E0"];
    row [label="T0 = T5 * DSTRIDE + T3\lT1 = T4\l", shape=box, fillcolor="white"];
    pix [label="DIDX = T0\lDPIX = COMB(FG, DPIX)\lT0++, T1--\l", shape=box, fillcolor="white"];
    check2 [label="T1 != 0 ?\l", shape=diamond, fillcolor="#E0E0E0"];
    next [label="T5++\lT2--\l", shape=box, fillcolor="white"];
    check3 [label="T2 != 0 ?\l", shape=diamond, fillcolor="#E0E0E0"];
    done [label="FLUSH\lJMP MAIN\l", shape=box, fillcolor="white"];
    end [label="END FILL\l", shape=oval, fillcolor="#F2F2F2"];
    start -> init;
    init -> clip;
    clip -> check1;
    check1 -> row [label="no"];
    check1 -> done [label="yes (W<=0)"];
    row -> pix;
    pix -> check2;
    check2 -> pix [label="yes"];
    check2 -> next [label="no"];
    next -> check3;
    check3 -> row [label="yes"];
    check3 -> done [label="no"];
    done -> end;
  }
  subgraph cluster_copy {
    label="COPY: Transparent Copy"; fontsize=18; fontname="Helvetica-Bold";
    start [label="START COPY\l", shape=oval, fillcolor="#F2F2F2"];
    pix [label="SIDX = T6, DIDX = T0\lDPIX = COMB(SPIX, DPIX)\l", shape=box, fillcolor="white"];
    inc [label="T6++, T0++, T1--\l", shape=box, fillcolor="white"];
    check [label="T1 != 0 ?\l", shape=diamond, fillcolor="#E0E0E0"];
    done [label="FLUSH, JMP MAIN\l", shape=box, fillcolor="white"];
    end [label="END COPY\l", shape=oval, fillcolor="#F2F2F2"];
    start -> pix;
    pix -> inc;
    inc -> check;
    check -> pix [label="yes"];
    check -> done [label="no"];
    done -> end;
  }
}
